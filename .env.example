# 실제 값은 이 파일이 아니라 Netlify 대시보드 → Site configuration →
# Environment variables 에만 등록하세요. 이 파일은 어떤 값이 필요한지 보여주는
# 예시일 뿐이며, 실제 키를 채워서 커밋하지 마세요.

# Cloudinary — 이미지 호스팅(URL 발급)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Meta — 인스타그램 자동 게시
IG_USER_ID=
IG_ACCESS_TOKEN=

# Meta — 스레드 자동 게시
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Google AI Studio — 문구 자동 생성
GEMINI_API_KEY=
